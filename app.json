{
  "expo": {
    "name": "GreenWave",
    "slug": "greenwave-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "greenwave",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cloud.gwgc.greenwave",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "GreenWave uses the camera so you can photograph pickups, dropoffs and material loads.",
        "NSPhotoLibraryUsageDescription": "GreenWave needs access to your photos so you can attach existing images to a job.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cloud.gwgc.greenwave",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3B5A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GreenWave needs access to your photos so you can attach images to a job.",
          "cameraPermission": "GreenWave uses the camera so you can photograph pickups, dropoffs and material loads."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3B5A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
