{
  "expo": {
    "name": "GreenWave",
    "slug": "greenwave-client-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greenwave",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anshrohit.RecyclingApp",
      "infoPlist": {
        "NSCameraUsageDescription": "GreenWave requires camera access to take photos of shipments and containers.",
        "NSPhotoLibraryUsageDescription": "GreenWave requires photo library access to upload container and job photos.",
        "NSMicrophoneUsageDescription": "GreenWave requires microphone access to record voice notes in team communication.",
        "NSContactsUsageDescription": "GreenWave requires contacts access to share contact information with team members.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anshrohit.RecyclingApp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECORD_AUDIO",
        "READ_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-secure-store",
      "expo-updates",
      "expo-audio",
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/4f362b61-c008-41c7-9a5c-1231731fff89"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "reactCompiler": true
    },
    "owner": "anshrohit",
    "extra": {
      "eas": {
        "projectId": "4f362b61-c008-41c7-9a5c-1231731fff89"
      }
    }
  }
}
