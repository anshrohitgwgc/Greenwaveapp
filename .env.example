# ==============================================================================
# GreenWave Infrastructure & Application - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Server & Node Runtime
NODE_ENV=
PORT=

# PostgreSQL 16 Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Redis 7 In-Memory Cache & Broker
REDIS_HOST=
REDIS_PORT=

# MinIO S3 Object Storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Authentication & Session Security
JWT_SECRET=
JWT_EXPIRATION=
SESSION_SECRET=

# Frontend & Mobile API URLs
VITE_API_URL=
EXPO_PUBLIC_API_URL=
