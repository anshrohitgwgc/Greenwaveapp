# ---------------------------------------------------------------
# GreenWave app environment
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the client.
# Never put secrets here — this file ships inside the app bundle.
# ---------------------------------------------------------------

# Mock mode: 1 = run entirely offline with in-memory demo data.
# Set to 0 once the business API is live.
EXPO_PUBLIC_USE_MOCK=1

# Base URL of the GreenWave business API, including the version prefix.
EXPO_PUBLIC_API_BASE_URL=https://api.gwgc.cloud/api/v1

# Optional: how long (ms) before an API request is aborted.
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional: max photos allowed per job (UI limit only; enforce on API too).
EXPO_PUBLIC_MAX_PHOTOS_PER_JOB=10
