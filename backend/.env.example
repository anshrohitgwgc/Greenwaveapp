# ==============================================================================
# GreenWave Infrastructure & Application - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE FOR LOCAL DEVELOPMENT.
# DO NOT COMMIT REAL PASSWORDS OR SECRETS TO SOURCE CONTROL.
# ==============================================================================

# Server & Node Runtime
NODE_ENV=
PORT=

# PostgreSQL 16 Database
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Redis 7 In-Memory Cache & Broker
REDIS_HOST=
REDIS_PORT=

# MinIO S3 Object Storage
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_USE_SSL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=

# Authentication & Session Security
JWT_SECRET=
JWT_EXPIRATION=
SESSION_SECRET=

# Business rounding rules (see docs/V2_ARCHITECTURE.md #13)
INVENTORY_ROUNDING_DECIMALS=3
CURRENCY_ROUNDING_DECIMALS=2

# Frontend & Mobile API URLs
VITE_API_URL=
EXPO_PUBLIC_API_URL=

# Browser origins permitted to call this API cross-origin, comma-separated.
# Leave blank to use the built-in defaults (the production frontend origins in
# production; those plus localhost in development). Never use "*" here — the
# API is authenticated.
# Example: https://gwgc.cloud,https://www.gwgc.cloud
CORS_ALLOWED_ORIGINS=
